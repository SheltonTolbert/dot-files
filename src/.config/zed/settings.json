// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "shelcp": {
      "command": {
        "path": "node",
        "args": [
          "/Users/sheltontolbert/repos/shel-mcp/dist/index.js",
          "--config",
          "/Users/sheltontolbert/repos/shel-mcp/config-custom"
        ],
        "env": null
      },
      "settings": {}
    }
  },
  "agent": {
    "default_profile": "shelcp",
    "profiles": {
      "shelcp": {
        "name": "Shelcp",
        "tools": {
                    "list_directory": true,
                    "grep": true,
                    "find_path": true,
                    "fetch": true,
                    "edit_file": true,
                    "diagnostics": true,
                    "delete_path": true,
                    "create_directory": true,
                    "copy_path": true
                },
        "enable_all_context_servers": false,
        "context_servers": {
                    "shelcp": {
                        "tools": {
                            "git-helper": true,
                            "code-analyzer": true
                        }
                    }
                }
      }
    },
    "always_allow_tool_actions": true,
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gemini-2.5-pro"
    },
    "version": "2"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "vim_mode": true
}
