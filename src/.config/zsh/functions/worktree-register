#!/usr/bin/env zsh

worktree-register() {
    local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/worktree"
    local config_file="$config_dir/projects.json"
    
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Error: Not in a git repository"
        return 1
    fi
    
    local git_root=$(git rev-parse --show-toplevel)
    local project_name=$(basename "$git_root")
    local repo_path="$git_root"
    
    mkdir -p "$config_dir"
    
    if [[ ! -f "$config_file" ]]; then
        echo '{}' > "$config_file"
    fi
    
    local existing_config=$(cat "$config_file")
    local worktrees=()
    
    git worktree list --porcelain | while read -r line; do
        if [[ $line =~ ^worktree\ (.+)$ ]]; then
            worktrees+=(${match[1]})
        fi
    done
    
    local worktrees_json="["
    local first=true
    for wt in $worktrees; do
        if [[ $first == true ]]; then
            first=false
        else
            worktrees_json+=","
        fi
        worktrees_json+="\"$wt\""
    done
    worktrees_json+="]"
    
    local updated_config=$(echo "$existing_config" | jq --arg name "$project_name" --arg path "$repo_path" --argjson worktrees "$worktrees_json" '. + {($name): {path: $path, worktrees: $worktrees}}')
    
    echo "$updated_config" > "$config_file"
    
    echo "Registered project '$project_name' at '$repo_path'"
    echo "Found $(echo "$worktrees_json" | jq length) worktree(s)"
}