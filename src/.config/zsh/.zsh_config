ZSH_THEME="agnoster"

plugins=(
git 
asdf 
npm 
yarn
brew 
colorize 
gem 
git-extras 
heroku 
node 
npm
rails 
ruby
zsh-autosuggestions
z
)

# Flush history safely so crashes do not drop commands
HISTSIZE=200000
SAVEHIST=200000
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
