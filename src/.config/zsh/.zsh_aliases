# scripts ======================================================
alias karma_focus="~/.dot-files/scripts/karma_focus.sh"
alias cache="~/.dot-files/scripts/cache.sh"
alias notes="vim ~/.vaults/Primary/Work"
alias snippets="~/.dot-files/src/scripts/snippets.sh"
alias create_snippet="~/.dot-files/src/scripts/create_snippet.sh"
# alias ccm="/Users/sheltontolbert/repos/claude_command_manager/ccm"

# AI stuff =========================================================
# "claude review write"
alias crw="python3 ~/.config/claude/hooks/review.py"
# "claude review read"
alias crr="vim ~/.local/reviews/"

alias chat="vim -c \"CodeCompanionChat gemini\" -c \"silent bd1\""
alias gcm="vim -c \"CodeCompanion /commit\" -c \"silent bd1\""
alias suggest="gh copilot suggest"

# SHELCORP =========================================================
alias shel="~/repos/shel_os/apps/control/main.sh"

# OS =========================================================
alias screenshots="open ~/Documents/Screenshots"
alias repos="cd ~/repos"

# Terminal ===================================================
alias c="clear"
alias config="~/.dot-files/src/scripts/config.sh"
alias statuskey="echo '\nconflicted: 󰈸\nahead: \nbehind: \ndiverged: 󰓁\nup_to_date: \nuntracked: \nstashed: 󰸐\nmodified: 󰧼\nrenamed: 󱀐\ndeleted: '"
alias tmuxinit="ls ~/.config/tmuxinator | sed 's/\.[^.]*$//' | xargs -I{} -n1 tmuxinator s {} --attach false"
alias ch="command_history"
mtc() { mix test "$@" --color | tee /dev/tty | pbcopy }

# Services
alias issues='jira issues list -a$(jira me) -s"To Do"'
alias my_issues="jira sprint list --plain --current --columns KEY,SUMMARY,STATUS -q \"Assignee = 'Shelton Tolbert' and (status != 'Duplicate' and status != 'Won\'t Do' and status != 'Done')\""

# Git
alias push="git branch --show-current | xargs -t git push origin"
alias fpush="git branch --show-current | xargs -t -I {} git push origin {} --force-with-lease"
alias co="git checkout"
alias gpopc="git reset --soft HEAD^"

# scripts ======================================================
alias cache="~/.dot-files/scripts/cache.sh"

# AI stuff =========================================================
alias chat="vim -c \"CodeCompanionChat gemini\" -c \"silent bd1\""
alias gcm="vim -c \"CodeCompanion /commit\" -c \"silent bd1\""

# OS =========================================================
alias screenshots="open ~/Documents/Screenshots"

