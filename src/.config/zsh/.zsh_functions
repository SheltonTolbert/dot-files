# Command History ============================================================

# Helper function to show most frequent commands
function _frequent_commands() {
  local count="${1:-10}"
  local history_file="$HOME/.zsh_history"

  if [[ ! -f "$history_file" ]]; then
    echo "Error: History file not found at $history_file"
    return 1
  fi

  # Extract commands, count frequencies, and get top N
  local frequent_commands=$(grep -v '^#' "$history_file" | \
    cut -d';' -f2- | \
    LC_ALL=C sort | \
    uniq -c | \
    LC_ALL=C sort -rn | \
    head -n "$count" | \
    sed -E 's/^[[:space:]]*[0-9]+[[:space:]]*//')

  local selected_command=$(echo "$frequent_commands" | fzf --scheme=history --tiebreak=index)

  if [[ -n "$selected_command" ]]; then
    echo "Executing: $selected_command"
    eval "$selected_command"
  fi
}

# command_history: Search command history with fzf and execute the selected command
# If a query is provided and only one match is found, execute it immediately
# Usage: ch [-f [N]] [query]
#   -f [N]  Show top N most frequent commands (default: 10)
function command_history() {
  local query=""
  local history_file="$HOME/.zsh_history"

  # Check for -f flag
  if [[ "$1" == "-f" ]]; then
    shift
    local count=10
    if [[ $1 =~ ^[0-9]+$ ]]; then
      count=$1
    fi
    _frequent_commands "$count"
    return $?
  fi

  # Regular history search
  query="$1"

  # Check if history file exists
  if [[ ! -f "$history_file" ]]; then
    echo "Error: History file not found at $history_file"
    return 1
  fi

  # Extract commands from history file (zsh history format: : timestamp:0;command)
  # Remove duplicates (keeping most recent occurrence)
  local history_commands=$(cat "$history_file" | sed -E 's/^: [0-9]+:[0-9]+;//' | awk '!seen[$0]++')

  if [[ -n "$query" ]]; then
    # Filter history with the query
    local matches=$(echo "$history_commands" | fzf --filter="$query")
    local match_count=$(echo "$matches" | grep -c '^' 2>/dev/null || echo 0)

    if [[ $match_count -eq 1 ]]; then
      # Only one match found, execute it immediately
      local selected_command="$matches"
      echo "Executing: $selected_command"
      eval "$selected_command"
      return $?
    elif [[ $match_count -eq 0 ]]; then
      # No matches found
      echo "No matches found for: $query"
      return 1
    else
      # Multiple matches, show fzf interface with the query
      local selected_command=$(echo "$matches" | fzf --tac --query="$query" --scheme=history --tiebreak=index)
    fi
  else
    # No query provided, show full fzf interface
    local selected_command=$(echo "$history_commands" | fzf --tac --scheme=history --tiebreak=index)
  fi

  # If a command was selected, execute it
  if [[ -n "$selected_command" ]]; then
    echo "Executing: $selected_command"
    eval "$selected_command"
  fi
}

