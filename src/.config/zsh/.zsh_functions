function add_snippet() {
  local snippet_name="$1"
  local snippet_content="$2"

  if [ -z "$snippet_name" ] || [ -z "$snippet_content" ]; then
    echo "Usage: add_snippet <name> <content>"
    return 1
  fi

  echo "$snippet_content" > ~/.dotfiles/scr/scripts/snippets/"$snippet_name"
  echo "Snippet '$snippet_name' added successfully."
}

