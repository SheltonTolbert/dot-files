ITEM_DIR="$HOME/.dotfiles/src/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.dotfiles/src/.config/sketchybar/plugins"


sketchybar --bar position=bottom height=20 blur_radius=30

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0x9934381b
  label.color=0x9934381b
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"
sketchybar --bar color=0x00ffffff


